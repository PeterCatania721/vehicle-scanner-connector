<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boli_product_tree" model="ir.ui.view">
        <field name="name">boli.product.list</field>
        <field name="model">boli.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_boli_product_form" model="ir.ui.view">
        <field name="name">boli.product.form</field>
        <field name="model">boli.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_boli_product" model="ir.actions.act_window">
        <field name="name">Bolli Product</field>
        <field name="res_model">boli.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>