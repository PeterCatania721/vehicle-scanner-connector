<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_scanner_config_form" model="ir.ui.view">
        <field name="name">vehicle.scanner.config.form</field>
        <field name="model">vehicle.scanner.config</field>
        <field name="arch" type="xml">
            <form string="Vehicle Scanner Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="API Credentials">
                            <field name="active"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                        <group string="Behavior">
                            <field name="allow_cors"/>
                            <field name="auto_create_vehicle"/>
                        </group>
                    </group>
                    <group string="Endpoints">
                        <div class="alert alert-info" role="alert">
                            <p><strong>BUHDA (Flask-compatible):</strong> POST /budha</p>
                            <p><strong>BUHDA (namespaced):</strong> POST /vehicle_scanner/budha</p>
                            <p><strong>Generic scanner:</strong> POST /vehicle_scanner/receive</p>
                            <p><strong>Legacy generic:</strong> POST /api/receive-vehicle-scan</p>
                            <p>All endpoints require <code>Authorization: Basic ...</code> and <code>Content-Type: application/json</code>.</p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vehicle_scanner_config_list" model="ir.ui.view">
        <field name="name">vehicle.scanner.config.list</field>
        <field name="model">vehicle.scanner.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="username"/>
                <field name="active"/>
                <field name="allow_cors"/>
                <field name="auto_create_vehicle"/>
            </list>
        </field>
    </record>

    <record id="action_vehicle_scanner_config" model="ir.actions.act_window">
        <field name="name">Scanner Configuration</field>
        <field name="res_model">vehicle.scanner.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>