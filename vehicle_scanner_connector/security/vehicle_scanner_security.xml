<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vehicle_scanner" model="ir.module.category">
        <field name="name">Vehicle Scanner</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_vehicle_scanner_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_vehicle_scanner"/>
    </record>

    <record id="group_vehicle_scanner_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vehicle_scanner"/>
        <field name="implied_ids" eval="[(4, ref('group_vehicle_scanner_user'))]"/>
    </record>

    <record id="fleet.fleet_group_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_vehicle_scanner_manager'))]"/>
    </record>
</odoo>