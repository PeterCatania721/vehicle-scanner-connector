<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vehicle_scanner" model="ir.module.category">
        <field name="name">Vehicle Scanner</field>
        <field name="sequence">35</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_vehicle_scanner">
        <field name="name">Vehicle Scanner</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="module_category_vehicle_scanner"/>
    </record>

    <record id="group_vehicle_scanner_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_vehicle_scanner"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_vehicle_scanner_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_vehicle_scanner"/>
        <field name="implied_ids" eval="[(4, ref('group_vehicle_scanner_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>